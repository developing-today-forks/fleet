# Docker build context for the fleet-build container is the fleet repo
# root (the :full target warms from the public submodules' sources).
# hatch-personal and cairn are PRIVATE: they are excluded here so
# their contents can never enter the context — and therefore never
# the public image — even though the submodules are checked out in
# some workspaces.
hatch-personal
cairn
.git
**/node_modules
